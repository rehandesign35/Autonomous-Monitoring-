SUPABASE_KEY=your_supabase_anon_or_service_role_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/path
DASHBOARD_URL=https://your-dashboard-vercel-url-here.vercel.app
